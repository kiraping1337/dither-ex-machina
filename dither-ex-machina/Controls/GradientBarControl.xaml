<UserControl x:Class="dither_ex_machina.Controls.GradientBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border x:Name="GradientPreviewBorder" Height="36"
                BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1"
                MouseLeftButtonDown="GradientPreviewBorder_MouseLeftButtonDown"
                Cursor="Hand"
                ToolTip="Клик - добавить точку градиента"/>

        <Canvas x:Name="MarkersCanvas" Height="16" Background="Transparent" Margin="0,2,0,0"/>

        <StackPanel x:Name="SelectedStopPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SelectedColorSwatch" Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="3"
                        BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1"
                        Margin="0,0,10,0" Cursor="Hand"
                        ToolTip="Клик - изменить цвет"
                        MouseLeftButtonDown="SelectedColorSwatch_MouseLeftButtonDown"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Позиция, %:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PositionTextBox" Width="50" VerticalAlignment="Center"
                             LostFocus="PositionTextBox_LostFocus"
                             KeyDown="PositionTextBox_KeyDown"/>
                </StackPanel>
            </Grid>

            <Button x:Name="DeleteStopButton" Content="Удалить точку"
                    Style="{DynamicResource PillButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Click="DeleteStopButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>