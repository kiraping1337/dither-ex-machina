<Window x:Class="dither_ex_machina.Controls.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:dither_ex_machina.Controls"
        Title="{DynamicResource PickerTitle}" Height="480" Width="600"
        Language="{DynamicResource UiLanguage}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                             ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BrushBlack}"
            BorderBrush="{DynamicResource BrushTurquoise}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--заголовок-->
            <Grid Grid.Row="0" Margin="0,0,0,417" Grid.RowSpan="2">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PickerHeader}" VerticalAlignment="Center" Margin="14,-2,0,0"
                               Foreground="{DynamicResource BrushTurquoise}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource PickerHeader}" VerticalAlignment="Center" Margin="16,0,0,0"
                                Foreground="{DynamicResource BrushWhite}" FontSize="20" FontWeight="Bold"/>
                </Grid>
                <Button Style="{DynamicResource CaptionCloseButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="CancelButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="554,10,0,0">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconExit}"
                              Fill="{DynamicResource BrushTurquoise}"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              VerticalAlignment="Top" RenderTransformOrigin="0.517,0.483"
                              Margin="-2,-2,0,0"/>
                        <Path Data="{StaticResource IconExit}"
                              Fill="{DynamicResource BrushWhite}"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              VerticalAlignment="Top" RenderTransformOrigin="0.517,0.483"/>
                    </Grid>
                </Button>
            </Grid>

            <!--контент-->
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="SVSquareContainer" Grid.Column="0" Width="256" Height="256" ClipToBounds="True">
                    <Rectangle x:Name="HueBackgroundRect"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1"/>
                    <Canvas x:Name="SVMarkerCanvas" Background="Transparent" Cursor="Cross"
                            MouseLeftButtonDown="SVSquare_MouseLeftButtonDown"
                            MouseMove="SVSquare_MouseMove"
                            MouseLeftButtonUp="SVSquare_MouseLeftButtonUp">
                        <Ellipse x:Name="SVMarkerOuter" Width="14" Height="14"
                                 Stroke="Black" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Ellipse x:Name="SVMarkerInner" Width="10" Height="10"
                                 Stroke="White" StrokeThickness="2" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <Grid x:Name="HueBarContainer" Grid.Column="1" Width="28" Height="256" Margin="14,0,0,0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1"/>
                    <Canvas x:Name="HueMarkerCanvas" Background="Transparent" Cursor="SizeNS"
                            MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                            MouseMove="HueBar_MouseMove"
                            MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
                        <Polygon x:Name="HueMarkerLeft" Points="0,0 9,5 0,10" Fill="White" IsHitTestVisible="False"/>
                        <Polygon x:Name="HueMarkerRight" Points="0,5 9,0 9,10" Fill="White" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="3" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource Swatches}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                    <Grid Width="140" Height="60">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" x:Name="NewColorSwatch" CornerRadius="3,3,0,0"
                                BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1,1,1,0"/>
                        <Border Grid.Row="1" x:Name="CurrentColorSwatch" CornerRadius="0,0,3,3"
                                BorderBrush="{DynamicResource BrushTurquoise}" BorderThickness="1"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource NewCurrent}" Foreground="{DynamicResource BrushTurquoiseDim}" FontSize="11" Margin="0,4,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="H:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HTextBox" Width="90" HorizontalAlignment="Left"
                                 LostFocus="HsvTextBox_LostFocus" KeyDown="HsvTextBox_KeyDown"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="STextBox" Width="90" HorizontalAlignment="Left"
                                 LostFocus="HsvTextBox_LostFocus" KeyDown="HsvTextBox_KeyDown"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="V:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="VTextBox" Width="90" HorizontalAlignment="Left"
                                 LostFocus="HsvTextBox_LostFocus" KeyDown="HsvTextBox_KeyDown"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="R:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="RTextBox" Width="90" HorizontalAlignment="Left" 
                                 LostFocus="RgbTextBox_LostFocus" KeyDown="RgbTextBox_KeyDown"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="G:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="GTextBox" Width="90" HorizontalAlignment="Left"
                                 LostFocus="RgbTextBox_LostFocus" KeyDown="RgbTextBox_KeyDown"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="B:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="BTextBox" Width="90" HorizontalAlignment="Left"
                                 LostFocus="RgbTextBox_LostFocus" KeyDown="RgbTextBox_KeyDown"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="#" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="HexTextBox" Width="110" HorizontalAlignment="Left"
                                 LostFocus="HexTextBox_LostFocus" KeyDown="HexTextBox_KeyDown" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                        <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True" controls:ButtonChrome.CornerRadius="3" />
                        <Button Content="{DynamicResource Cancel}" Width="80" Click="CancelButton_Click" IsCancel="True" controls:ButtonChrome.CornerRadius="3"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>