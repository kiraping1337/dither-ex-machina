<Window x:Class="dither_ex_machina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dither_ex_machina"
        xmlns:controls="clr-namespace:dither_ex_machina.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Language="{DynamicResource UiLanguage}"
        Title="Dither Ex Machina" Height="820" Width="1100"
        MinWidth="780" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">

        <!--КАРТОЧКА ОКНА-->
        <Border x:Name="CardBorder"
                Background="{StaticResource BrushBlack}"
                BorderBrush="{StaticResource BrushTurquoise}"
                BorderThickness="1"
                CornerRadius="10"
                SizeChanged="CardBorder_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--ЗАГОЛОВОК-->
                <Grid Grid.Row="0">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,5,0,0">
                        <TextBlock Text="DITHER EX MACHINA"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource BrushSliderThumbHover}"
                                   FontSize="27"
                                   Margin="-2,-2,0,0"/>

                        <TextBlock Text="DITHER EX MACHINA"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource BrushWhite}"
                                   FontSize="27"/>
                    </Grid>

                    <!--ЛОГОТИП-->
                    <Grid x:Name="EyeLogo"
                          Width="80" Height="32"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False">

                        <Canvas Width="80" Height="32" Margin="0,0,0,-5">

                            <!-- Верхнее веко -->
                            <Path x:Name="EyelidTop"
                                  Stroke="{StaticResource BrushTurquoise}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>

                            <!-- Нижнее веко -->
                            <Path x:Name="EyelidBottom"
                                  Stroke="{StaticResource BrushTurquoise}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>

                            <!-- Зрачок -->
                            <Canvas x:Name="PupilCanvas" Width="80" Height="32">
                                <Path x:Name="EyePupil"
                                      Fill="{StaticResource BrushTurquoise}"
                                      Opacity="0"
                                      RenderTransformOrigin="0.5,0.5"
                                      Data="F0 M31,16 A9,9 0 1 0 49,16 A9,9 0 1 0 31,16 Z
                                            M36,16 A4,4 0 1 0 44,16 A4,4 0 1 0 36,16 Z">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="EyePupilScaleTransform"/>
                                            <TranslateTransform x:Name="EyePupilTransform"/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>

                        </Canvas>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,-5">
                        <Border BorderBrush="{StaticResource BrushTurquoiseDim}" BorderThickness="1"
                                CornerRadius="5" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EnglishLanguageOption" Content="EN" GroupName="UiLanguage"
                                             AutomationProperties.Name="English"
                                             Style="{StaticResource LanguageOptionStyle}" Click="LanguageOption_Click"/>
                                <RadioButton x:Name="RussianLanguageOption" Content="RU" GroupName="UiLanguage"
                                             AutomationProperties.Name="Русский"
                                             Style="{StaticResource LanguageOptionStyle}" Click="LanguageOption_Click"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWrap}"
                                      Fill="{DynamicResource BrushTurquoise}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="-1,0,1,0"/>
                                <Path Data="{StaticResource IconWrap}"
                                      Fill="{DynamicResource BrushWhite}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top" Margin="0,14,0,0"/>

                            </Grid>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUnWrap}"
                                      Fill="{DynamicResource BrushTurquoise}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="-2,-2,0,0"/>
                                <Path Data="{StaticResource IconUnWrap}"
                                      Fill="{DynamicResource BrushWhite}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CaptionCloseButtonStyle}"
                                Click="CloseButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconExit}"
                                      Fill="{DynamicResource BrushTurquoise}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top" RenderTransformOrigin="0.517,0.483"
                                      Margin="-2,-2,0,0"/>
                                <Path Data="{StaticResource IconExit}"
                                      Fill="{DynamicResource BrushWhite}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top" RenderTransformOrigin="0.517,0.483"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--ОСНОВНОЙ КОНТЕНТ-->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushBlack}"
                            BorderBrush="{StaticResource BrushTurquoise}" BorderThickness="1"
                            CornerRadius="10"
                            Margin="8">
                        <Grid x:Name="PreviewClipGrid" SizeChanged="PreviewClipGrid_SizeChanged"
                              Background="Transparent"
                              MouseWheel="PreviewBorder_MouseWheel"
                              MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown"
                              MouseLeftButtonUp="PreviewBorder_MouseLeftButtonUp"
                              MouseMove="PreviewBorder_MouseMove">
                            <Image x:Name="PreviewImage" Stretch="Uniform">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="PreviewTranslate"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" Margin="10">
                                <Button x:Name="ResetZoomButton" Click="ResetZoomButton_Click"
                                        Style="{StaticResource AnimatedActionButtonStyle}"
                                        ToolTip="{DynamicResource ResetZoom}"
                                        AutomationProperties.Name="{DynamicResource ResetZoom}" Margin="0,0,10,0"
                                        controls:ButtonChrome.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconResetScale}"
                                                  Fill="{DynamicResource BrushTurquoise}"
                                                  Width="20" Height="20"
                                                  Stretch="Uniform" RenderTransformOrigin="0.35,0.65"
                                                  Margin="-2,-2,0,0"/>
                                            <Path Data="{StaticResource IconResetScale}"
                                                  Fill="{DynamicResource BrushWhite}"
                                                  Width="20" Height="20"
                                                  Stretch="Uniform" RenderTransformOrigin="0.35,0.65"/>
                                        </Grid>
                                    </StackPanel>

                                </Button>
                                <StackPanel MinWidth="180">
                                    <TextBlock Text="{DynamicResource PreviewResolution}" FontSize="11" Margin="0,0,0,2"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="PreviewResolutionSlider"
                                                Minimum="0.1" Maximum="1" Value="1"
                                                ValueChanged="PreviewResolutionSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=PreviewResolutionSlider, Path=Value, StringFormat=P0}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,8,8">
                        <StackPanel Margin="10">

                            <Button x:Name="OpenImageButton" Style="{StaticResource BigActionButtonStyle}"
                                    Click="OpenButton_Click" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconOpenFile}"
                                      Fill="{DynamicResource BrushWhite}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource OpenImage}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveImageButton" Style="{StaticResource BigActionButtonStyle}"
                                    Click="SaveButton_Click" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconSaveFile}"
                                      Fill="{DynamicResource BrushWhite}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource SaveImage}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{DynamicResource EffectMode}" Style="{StaticResource SectionHeaderStyle}"/>
                            <ComboBox x:Name="ModeComboBox"
                                      SelectionChanged="ModeComboBox_SelectionChanged"
                                      Margin="0,6,0,16">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock local:MainWindow.EffectNameKey="{Binding DisplayNameKey}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushWhite}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushBlack}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel x:Name="EffectParametersPanel"/>

                            <Separator Margin="0,16,0,14"/>

                            <TextBlock Text="{DynamicResource Preprocessing}" Style="{StaticResource SectionHeaderStyle}"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource MedianRadius}"
                                           HorizontalAlignment="Left" TextWrapping="Wrap" Width="220"/>
                                <TextBlock Text="{Binding ElementName=MedianRadiusSlider, Path=Value, StringFormat=F0}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="MedianRadiusSlider" Minimum="0" Maximum="8" Value="3" ValueChanged="Param_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource BlurRadius}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=BlurRadiusSlider, Path=Value, StringFormat=F0}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="BlurRadiusSlider" Minimum="0" Maximum="15" Value="3" ValueChanged="Param_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource ShadowCutoff}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=CutoffSlider, Path=Value, StringFormat=F2}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="CutoffSlider" Minimum="0" Maximum="0.5" Value="0.05" ValueChanged="Param_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource HighlightCutoff}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=HighlightCutoffSlider, Path=Value, StringFormat=F2}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="HighlightCutoffSlider" Minimum="0.5" Maximum="1" Value="0.92" ValueChanged="Param_Changed"/>

                            <Separator Margin="0,16,0,14"/>

                            <TextBlock Text="{DynamicResource Contrast}" Style="{StaticResource SectionHeaderStyle}"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource ContrastCenter}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=ContrastCenterSlider, Path=Value, StringFormat=F2}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="ContrastCenterSlider" Minimum="0" Maximum="1" Value="0.5" ValueChanged="Param_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource ContrastSteepness}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=ContrastSteepnessSlider, Path=Value, StringFormat=F2}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="ContrastSteepnessSlider" Minimum="0.5" Maximum="15" Value="1" ValueChanged="Param_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource PostSmooth}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=PostContrastSmoothSlider, Path=Value, StringFormat=F0}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="PostContrastSmoothSlider" Minimum="0" Maximum="10" Value="2" ValueChanged="Param_Changed"/>

                            <Separator Margin="0,16,0,14"/>

                            <Grid>
                                <TextBlock Text="{DynamicResource Supersampling}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ElementName=SupersampleSlider, Path=Value, StringFormat=F0}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SupersampleSlider" Minimum="1" Maximum="4" Value="3"
                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Param_Changed"/>

                            <Separator Margin="0,16,0,14"/>

                            <CheckBox x:Name="GradientMapEnabledCheckBox" Content="{DynamicResource GradientMap}"
                                      Checked="GradientMapEnabledCheckBox_Changed"
                                      Unchecked="GradientMapEnabledCheckBox_Changed"/>
                            <controls:GradientBarControl x:Name="GradientEditor" Margin="0,12,0,0"
                                                          Visibility="Collapsed"
                                                          GradientChanged="GradientEditor_GradientChanged"/>

                            <CheckBox x:Name="InvertCheckBox" Content="{DynamicResource Invert}" Margin="0,16,0,0"
                                      Checked="Param_Changed" Unchecked="Param_Changed"/>

                            <CheckBox x:Name="GlowEnabledCheckBox" Content="{DynamicResource Glow}" Margin="0,16,0,0"
                                      Checked="GlowEnabledCheckBox_Changed"
                                      Unchecked="GlowEnabledCheckBox_Changed"/>
                            <StackPanel x:Name="GlowControlsPanel" Visibility="Collapsed">
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource GlowRadius}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding ElementName=GlowRadiusSlider, Path=Value, StringFormat=F0}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="GlowRadiusSlider" Minimum="1" Maximum="30" Value="8" ValueChanged="Param_Changed"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource GlowThreshold}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding ElementName=GlowThresholdSlider, Path=Value, StringFormat=F2}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="GlowThresholdSlider" Minimum="0" Maximum="1" Value="0.6" ValueChanged="Param_Changed"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource GlowIntensity}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding ElementName=GlowIntensitySlider, Path=Value, StringFormat=F2}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="GlowIntensitySlider" Minimum="0" Maximum="2" Value="0.8" ValueChanged="Param_Changed"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>